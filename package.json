{
  "name": "pt-lab-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/pt-lab",
    "packages/demo"
  ],
  "scripts": {
    "dev": "npm run --workspace packages/demo dev",
    "build": "npm run --workspace packages/demo build",
    "preview": "npm run --workspace packages/demo preview",
    "demo:dev": "npm run --workspace packages/demo dev",
    "demo:build": "npm run --workspace packages/demo build",
    "pkg:build": "npm run --workspace packages/pt-lab build",
    "pkg:dev": "npm run --workspace packages/pt-lab dev",
    "check": "npm run --workspace packages/pt-lab check && npm run --workspace packages/demo check"
  }
}
