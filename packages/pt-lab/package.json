{
  "name": "pt-lab",
  "version": "0.1.0",
  "description": "Browser GPU path tracing + scene editor (three.js + three-gpu-pathtracer)",
  "type": "module",
  "svelte": "./src/index.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist --watch",
    "prepublishOnly": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "keywords": [
    "path-tracing",
    "three",
    "webgl",
    "svelte"
  ],
  "license": "MIT",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "oidn-web": "^0.3.5",
    "three": "^0.185.1",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.11"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/three": "^0.185.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
